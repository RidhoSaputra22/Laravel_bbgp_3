#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
binary="$project_root/storage/app/bbpg-sync-worker"

if [[ -f "$project_root/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$project_root/.env"
    set +a
fi

if [[ ! -x "$binary" ]]; then
    echo "Worker belum dibuild: $binary" >&2
    echo "Jalankan: bash bin/build-sync-worker" >&2
    exit 1
fi

exec "$binary" "$@"
